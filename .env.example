# ---------------------------------------------------------------------------
# PhotonV - 开源微视频平台
# 复制为 .env 后按需修改
# ---------------------------------------------------------------------------

# --- 基础 ---------------------------------------------------------------
APP_ENV=production
HOST=0.0.0.0
PORT=8080
# 站点对外地址（分享链接、封面绝对地址会用到）
SITE_URL=http://localhost:8080

# --- 安全 ---------------------------------------------------------------
# 务必修改：openssl rand -hex 48
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=14

# --- 数据库（PostgreSQL）------------------------------------------------
DATABASE_URL=postgresql+psycopg://photonv:photonv@localhost:5432/photonv

# --- 存储 ---------------------------------------------------------------
# 视频、封面、头像、备份都放在这个目录
DATA_DIR=./data
# 单个视频文件上限（MB）
MAX_VIDEO_MB=2048
# 单张图片上限（MB）
MAX_IMAGE_MB=16

# --- Redis（可选，强烈推荐）---------------------------------------------
# 配置后启用：首页/元数据缓存、分布式限流、在线人数、WebSocket 多进程广播
# 留空则使用内置实现，功能不受影响
REDIS_URL=
# 缓存时间（秒），可在后台「缓存与分布式」里覆盖
CACHE_TTL_SECONDS=20

# --- 转码（需要 ffmpeg）--------------------------------------------------
# 留空会自动从 PATH 查找 ffmpeg，也可以指定绝对路径
FFMPEG_BIN=
# 上传后是否自动转码出多清晰度
TRANSCODE_ENABLED=true
# 同时转码的任务数（按 CPU 核数调整）
TRANSCODE_CONCURRENCY=1
# HLS 分片长度（秒）
HLS_SEGMENT_SECONDS=6

# --- 构建加速（可选）-----------------------------------------------------
APT_MIRROR=deb.debian.org

# --- 首次运行 -----------------------------------------------------------
# 初始化时创建的超级管理员
ROOT_USERNAME=root
ROOT_PASSWORD=photonv123456
ROOT_EMAIL=root@photonv.local
