# ---------------------------------------------------------------------------
# PhotonV - 开源微视频平台
# 复制为 .env 后按需修改
# ---------------------------------------------------------------------------

# --- 基础 ---------------------------------------------------------------
APP_ENV=production
HOST=0.0.0.0
PORT=8080
# 站点对外地址（分享链接、封面绝对地址会用到）
SITE_URL=http://localhost:8080

# --- 安全 ---------------------------------------------------------------
# 务必修改：openssl rand -hex 48
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=14

# --- 数据库（PostgreSQL）------------------------------------------------
DATABASE_URL=postgresql+psycopg://photonv:photonv@localhost:5432/photonv

# --- 存储 ---------------------------------------------------------------
# 视频、封面、头像、备份都放在这个目录
DATA_DIR=./data
# 单个视频文件上限（MB）
MAX_VIDEO_MB=2048
# 单张图片上限（MB）
MAX_IMAGE_MB=16

# --- 构建加速（可选）-----------------------------------------------------
APT_MIRROR=deb.debian.org

# --- 首次运行 -----------------------------------------------------------
# 初始化时创建的超级管理员
ROOT_USERNAME=root
ROOT_PASSWORD=photonv123456
ROOT_EMAIL=root@photonv.local
