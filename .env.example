# ---------------------------------------------------------------------------
# PhotonV - 开源微视频平台
# 复制为 .env 后按需修改
# ---------------------------------------------------------------------------

# --- 基础 ---------------------------------------------------------------
APP_ENV=production
HOST=0.0.0.0
PORT=8080
# 站点对外地址（分享链接、封面绝对地址会用到）
SITE_URL=http://localhost:8080

# --- 安全 ---------------------------------------------------------------
# 务必修改：openssl rand -hex 48
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=14

# --- 数据库（PostgreSQL）------------------------------------------------
DATABASE_URL=postgresql+psycopg://photonv:photonv@localhost:5432/photonv

# --- 存储 ---------------------------------------------------------------
# 视频、封面、头像、备份都放在这个目录
DATA_DIR=./data
# 单个视频文件上限（MB）
MAX_VIDEO_MB=2048
# 单张图片上限（MB）
MAX_IMAGE_MB=16

# --- Redis（可选，强烈推荐）---------------------------------------------
# 配置后启用：首页/元数据缓存、分布式限流、在线人数、WebSocket 多进程广播
# 留空则使用内置实现，功能不受影响
REDIS_URL=
# 缓存时间（秒），可在后台「缓存与分布式」里覆盖
CACHE_TTL_SECONDS=20

# --- 转码（需要 ffmpeg）--------------------------------------------------
# 留空会自动从 PATH 查找 ffmpeg，也可以指定绝对路径
FFMPEG_BIN=
# 上传后是否自动转码出多清晰度
TRANSCODE_ENABLED=true
# 同时转码的任务数（按 CPU 核数调整）
TRANSCODE_CONCURRENCY=1
# HLS 分片长度（秒）
HLS_SEGMENT_SECONDS=6

# --- 直播接入（MediaMTX）-------------------------------------------------
# 媒体服务器管理 API，服务端用来查询「谁在推流」；docker 里是 http://mediamtx:9997
LIVE_API_URL=http://127.0.0.1:9997
# OBS 里「服务器」填这个地址（不要带 /live，那是路径前缀）
LIVE_RTMP_SERVER=rtmp://localhost:1935
# 浏览器开播（WHIP 推流）与 WebRTC 播放（WHEP）
LIVE_WHIP_BASE=http://localhost:8889
LIVE_WHEP_BASE=http://localhost:8889
# HLS 播放
LIVE_HLS_BASE=http://localhost:8888
# 以上四项在生产环境请换成公网域名，例如：
#   LIVE_RTMP_SERVER=rtmp://live.example.com:1935
#   LIVE_WHIP_BASE=https://live.example.com
#   LIVE_WHEP_BASE=https://live.example.com
#   LIVE_HLS_BASE=https://hls.example.com

# --- 构建加速（可选）-----------------------------------------------------
APT_MIRROR=deb.debian.org

# --- 首次运行 -----------------------------------------------------------
# 初始化时创建的超级管理员
ROOT_USERNAME=root
ROOT_PASSWORD=photonv123456
ROOT_EMAIL=root@photonv.local
